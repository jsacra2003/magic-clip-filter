# =============================================================================
# Magic Clip Filter — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Core (required by all agents and deployment)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Must be a valid Vertex AI region for deployment (not "eu-west1" or "global").
# Use "europe-west1" for EU, "us-central1" for US.
GOOGLE_CLOUD_LOCATION="europe-west1"

# Always 1 / True when using Vertex AI backend
GOOGLE_GENAI_USE_VERTEXAI=1

# -----------------------------------------------------------------------------
# Model selection (optional — defaults shown)
# -----------------------------------------------------------------------------
MODEL_AGENT="gemini-2.5-pro"
MODEL_TOOL="gemini-2.5-flash"

# -----------------------------------------------------------------------------
# YouTube Data API v3 (required by agent05 — YouTube Highlights)
# Enable "YouTube Data API v3" in GCP Console → APIs & Services → Credentials
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY="your-youtube-api-key"

# -----------------------------------------------------------------------------
# Google Custom Search API (required by agent04 — Adverse Media / PG-16 check)
# Enable "Custom Search API" in GCP Console → APIs & Services
# Create a Programmable Search Engine at https://programmablesearchengine.google.com
# -----------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY="your-google-search-api-key"
GOOGLE_CSE_ID="your-custom-search-engine-id"

# -----------------------------------------------------------------------------
# Deployment (required by make deploy)
# Create a GCS bucket in your project for staging the deployment artifact
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_STORAGE_BUCKET="your-gcs-bucket-name"

# Populated automatically by the deployment script after first deploy
AGENT_ENGINE_ID=""

# -----------------------------------------------------------------------------
# LinkedIn MCP Server (required by LinkedInPublisherAgent)
# 1. Create a LinkedIn Developer App at https://www.linkedin.com/developers/apps
# 2. Add OAuth 2.0 redirect URI: http://localhost:8080/callback
# 3. Request scopes: openid, profile, email, w_member_social
# 4. Run 'make linkedin-auth' — it opens the browser, exchanges the code, and
#    saves LINKEDIN_ACCESS_TOKEN to this file automatically.
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:8080/callback"
LINKEDIN_ACCESS_TOKEN=""  # Set automatically by 'make linkedin-auth'

# -----------------------------------------------------------------------------
# Telemetry / Logging (optional)
# If set, LLM completions are streamed to this GCS bucket for observability
# -----------------------------------------------------------------------------
# LOGS_BUCKET_NAME="your-logs-bucket-name"
