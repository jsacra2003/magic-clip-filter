# All environment variables are defined at the project root.
# From the magic-clip-filter/ directory, run:
#   cp .env.example .env
#
# Variables used by this agent:
#   GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION, GOOGLE_GENAI_USE_VERTEXAI
#   MODEL_AGENT, MODEL_TOOL
#   GOOGLE_CLOUD_STORAGE_BUCKET  (deployment only)
#   AGENT_ENGINE_ID              (populated after deploy)
